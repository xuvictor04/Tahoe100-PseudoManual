#!/usr/bin/env bash
# tahoe - the one-shot Tahoe-100M gene map, in short commands (Linux / macOS). `tahoe help` lists them.
#
#   tahoe setup        Python environment (~/tahoe-venv) and the `tahoe` command on your PATH
#   tahoe run          everything, in the background (safe to log out); `tahoe run --stream` needs no download
#   tahoe              where things stand (= tahoe status)
#   tahoe gene MDM2    which drugs raise / lower MDM2, in which cell lines, which genes move with it
#   tahoe review ...   literature-review agents on a finished run (docs/review.md); tahoe duplicate DEST copies a run
#
# Folders: data = --data DIR, else $TAHOE_DATA, else ~/Tahoe-100M; output = --out DIR, else $TAHOE_OUT, else
# <data>/tahoemap; venv = $TAHOE_VENV or ~/tahoe-venv. --data / --out go with any command (give the same ones to
# run, stop, log and the look-ups). Windows has no wrapper: see docs/quick-start.md.
set -uo pipefail

resolve() {                      # this script's real path, through symlinks (no readlink -f on macOS)
  local p="$1" d
  while [ -L "$p" ]; do
    d="$(cd -P "$(dirname "$p")" && pwd)"
    p="$(readlink "$p")"
    case "$p" in /*) ;; *) p="$d/$p" ;; esac
  done
  echo "$(cd -P "$(dirname "$p")" && pwd)/$(basename "$p")"
}
absolute() { case "$1" in /*) echo "$1" ;; "~"*) echo "$HOME${1#\~}" ;; *) echo "$PWD/$1" ;; esac; }

# --data / --out on the command line (`--out DIR` or `--out=DIR`, anywhere) choose this command's folders, and so the
# job's pid file and console log; every other argument is passed on unchanged.
DATA_ARG="" OUT_ARG="" ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --data|--out)
      [ $# -ge 2 ] || { printf 'tahoe: %s needs a folder\n' "$1" >&2; exit 1; }
      if [ "$1" = --data ]; then DATA_ARG="$2"; else OUT_ARG="$2"; fi
      shift 2 ;;
    --data=*) DATA_ARG="${1#--data=}"; shift ;;
    --out=*) OUT_ARG="${1#--out=}"; shift ;;
    *) ARGS+=("$1"); shift ;;
  esac
done
set -- ${ARGS[@]+"${ARGS[@]}"}

SELF="$(resolve "${BASH_SOURCE[0]}")"
REPO="$(dirname "$SELF")"
DATA="$(absolute "${DATA_ARG:-${TAHOE_DATA:-$HOME/Tahoe-100M}}")"
if [ -n "$OUT_ARG" ]; then OUT="$(absolute "$OUT_ARG")"; else OUT="$(absolute "${TAHOE_OUT:-$DATA/tahoemap}")"; fi
VENV="$(absolute "${TAHOE_VENV:-$HOME/tahoe-venv}")"
PY="python3"
[ -x "$VENV/bin/python" ] && PY="$VENV/bin/python"
PIDF="$OUT/.job.pid"             # the job's pid; the job removes it when it ends (tahoemap/cli.py, JOB_PID)
CONSOLE="$OUT/console.log"
PKGS="numpy pandas pyarrow scipy scikit-learn networkx psutil huggingface_hub hf_xet brotli>=1.2.0 anthropic"
SAME=""                          # the folder options to repeat in the commands suggested to the user
[ -n "$DATA_ARG" ] && SAME="$SAME --data $(printf %q "$DATA")"
[ -n "$OUT_ARG" ] && SAME="$SAME --out $(printf %q "$OUT")"
# A background job gets its own session (setsid) or process group (no setsid on macOS: Python's setpgrp, then exec),
# keeping its pid, so `tahoe stop` reaches every worker and download it started.
if command -v setsid >/dev/null 2>&1; then
  LAUNCH=(setsid nohup)
else
  LAUNCH=(nohup "$PY" -c 'import os, sys; os.setpgrp(); os.execvp(sys.argv[1], sys.argv[1:])')
fi

say() { printf '%s\n' "$*"; }
die() { printf 'tahoe: %s\n' "$*" >&2; exit 1; }
tm() { (cd "$REPO" && "$PY" -m tahoemap "$@" --data "$DATA" --out "$OUT"); }

need_packages() {
  "$PY" -c "import numpy, pandas, pyarrow, scipy, sklearn, networkx" 2>/dev/null ||
    die "Python packages missing: run 'tahoe setup' first (or: $PY -m pip install $PKGS)"
}

job_cmd() { ps -ww -p "$1" -o command= 2>/dev/null; }

job_pid() {                      # the running job's pid: alive, and a tahoemap job or the download (not a reused pid)
  [ -f "$PIDF" ] || return 1
  local p
  p="$(cat "$PIDF" 2>/dev/null)"
  case "$p" in ''|*[!0-9]*) return 1 ;; esac
  kill -0 "$p" 2>/dev/null || return 1
  case "$(job_cmd "$p")" in *tahoemap*|*"hf download"*) echo "$p"; return 0 ;; esac
  return 1
}

streamed_build_unfinished() { [ -f "$OUT/hf/file_plates.json" ] && [ ! -f "$OUT/stages/build.json" ]; }

start_job() {                    # run `python -m tahoemap ARGS` detached; its own log is $OUT/run.log
  local p
  if p="$(job_pid)"; then
    die "a job is already running (pid $p): 'tahoe log$SAME' to watch it, 'tahoe stop$SAME' to stop it"
  fi
  mkdir -p "$OUT"
  [ -f "$CONSOLE" ] && mv -f "$CONSOLE" "$CONSOLE.prev"
  (cd "$REPO" || exit 1
   export TAHOE_JOB=1
   exec "${LAUNCH[@]}" "$PY" -m tahoemap "$@" --data "$DATA" --out "$OUT" </dev/null >"$CONSOLE" 2>&1 &
   echo $! >"$PIDF")
  sleep 2
  if p="$(job_pid)"; then
    say "Started (pid $p): tahoemap $*"
    if [ -z "$SAME" ]; then
      say "  follow it:  tahoe log        stop it:  tahoe stop        where things stand:  tahoe"
    else
      say "  follow it:           tahoe log$SAME"
      say "  stop it:             tahoe stop$SAME"
      say "  where things stand:  tahoe$SAME"
    fi
  elif grep -qs "Run done\|nothing to do\|Nothing to review\|Nothing to check again\|Dry run:\|^\[[0-9:]*\] Review run:" \
       "$CONSOLE"; then
    tail -n 3 "$CONSOLE"
  else
    say "The job ended at once. Its output:"
    tail -n 30 "$CONSOLE"
    exit 1
  fi
}

cmd_setup() {
  command -v python3 >/dev/null || die "python3 not found: install Python 3.10 or newer"
  python3 -c 'import sys; sys.exit(sys.version_info < (3, 10))' || say "warning: Python 3.10+ is recommended"
  if [ ! -x "$VENV/bin/python" ]; then
    say "Creating the Python environment $VENV ..."
    python3 -m venv "$VENV" || die "could not create $VENV (Debian/Ubuntu: sudo apt-get install python3-venv)"
  fi
  "$VENV/bin/python" -m pip install -q -U pip
  # shellcheck disable=SC2086
  "$VENV/bin/python" -m pip install -q -U $PKGS || die "pip install failed"
  "$VENV/bin/python" -m pip show brotlicffi >/dev/null 2>&1 && "$VENV/bin/python" -m pip install -q -U brotlicffi
  mkdir -p "$HOME/.local/bin"
  ln -sf "$SELF" "$HOME/.local/bin/tahoe"
  case ":$PATH:" in
    *":$HOME/.local/bin:"*) say "Done. Type: tahoe help" ;;
    *) local rc="$HOME/.bashrc"
       case "${SHELL:-}" in *zsh) rc="$HOME/.zshrc" ;; esac
       grep -qs 'HOME/.local/bin' "$rc" || echo 'export PATH="$HOME/.local/bin:$PATH"' >>"$rc"
       say "Done. Open a new terminal (or type: export PATH=\"\$HOME/.local/bin:\$PATH\"), then: tahoe help" ;;
  esac
}

cmd_download() {                 # the expression files and the four small metadata tables (~338 GB)
  [ -x "$VENV/bin/hf" ] || die "run 'tahoe setup' first"
  if job_pid >/dev/null; then die "a job is running; wait for it or 'tahoe stop$SAME'"; fi
  mkdir -p "$DATA" "$OUT"
  df -hP "$DATA" | tail -1 | awk '{print "Free space at " $6 ": " $4 " (the download needs ~340 GB; or use: tahoe run --stream)"}'
  # the last line of download.log says how it ended (DOWNLOAD DONE / FAILED; tahoe stop adds STOPPED)
  ("${LAUNCH[@]}" env PATH="$VENV/bin:$PATH" bash -c '
     ok=1
     for i in 1 2 3; do
       hf download tahoebio/Tahoe-100M --repo-type dataset --local-dir "$0" \
         --include "data/*.parquet" --include "metadata/gene_metadata.parquet" \
         --include "metadata/sample_metadata.parquet" --include "metadata/cell_line_metadata.parquet" \
         --include "metadata/drug_metadata.parquet" && { ok=0; break; }
       sleep 10
     done
     if [ $ok = 0 ]; then echo "DOWNLOAD DONE $(date "+%Y-%m-%d %H:%M:%S")"
     else echo "DOWNLOAD FAILED after 3 tries $(date "+%Y-%m-%d %H:%M:%S")"; fi
     [ "$(cat "$1" 2>/dev/null)" = "$$" ] && rm -f "$1"
     exit $ok' "$DATA" "$PIDF" </dev/null >"$OUT/download.log" 2>&1 & echo $! >"$PIDF")
  say "Downloading into $DATA in the background (resumes if restarted). Log: tahoe log download$SAME"
}

job_is_review() { case "$(job_cmd "$1")" in *"tahoemap review"*) return 0 ;; esac; return 1; }

cmd_log() {
  local f="$OUT/run.log" p
  case "${1:-}" in
    download) f="$OUT/download.log" ;;
    review) f="$OUT/review/review.log" ;;
    *) if p="$(job_pid)" && job_is_review "$p"; then f="$CONSOLE"; fi ;;   # a review job: its whole console
  esac
  [ -f "$f" ] || f="$CONSOLE"
  [ -f "$f" ] || die "no log yet in $OUT"
  say "(Ctrl-C stops watching, not the job)"
  exec tail -n 30 -F "$f"
}

cmd_stop() {
  local p g kind=job log="$OUT/run.log" wait=15
  p="$(job_pid)" || { rm -f "$PIDF"; say "Nothing is running."; return 0; }
  # a review gives its entities in progress 15 s to stop, then writes the ledger and its tables: wait longer for it
  case "$(job_cmd "$p")" in
    *"hf download"*) kind=download; log="$OUT/download.log" ;;
    *"tahoemap review"*) kind=review; log="$OUT/review/review.log"; wait=90 ;;
  esac
  g="$(ps -o pgid= -p "$p" 2>/dev/null | tr -d ' ')"
  local target=("$p")
  [ "$g" = "$p" ] && target=(-- "-$p")        # it leads its own process group: its workers and downloads too
  alive() { kill -0 "${target[@]}" 2>/dev/null; }
  say "Stopping the $kind (pid $p) ..."
  kill -TERM "${target[@]}" 2>/dev/null
  for _ in $(seq 1 "$wait"); do alive || break; sleep 1; done
  if alive; then
    kill -KILL "${target[@]}" 2>/dev/null
    for _ in 1 2 3 4 5; do alive || break; sleep 1; done
  fi
  if alive; then
    say "pid $p (or a process it started) is still running: try 'tahoe stop$SAME' again, or: kill -9 $p"
    return 1
  fi
  if [ $kind = download ]; then
    echo "DOWNLOAD STOPPED by tahoe stop $(date "+%Y-%m-%d %H:%M:%S")" >>"$log"
    rm -f "$PIDF"
    say "Stopped. 'tahoe download$SAME' resumes it."
    return 0
  fi
  echo "[$(date +%H:%M:%S)] STOPPED by tahoe stop" >>"$log"
  rm -f "$PIDF"
  if [ $kind = review ]; then
    say "Stopped. Finished reviews are kept and the ones in progress are marked paused: the same 'tahoe review" \
        "run ...$SAME' resumes it ('tahoe review status$SAME' says where it stands)."
  elif streamed_build_unfinished; then
    say "Stopped. Finished plates are kept: 'tahoe run$SAME' continues the streamed build (it keeps streaming," \
        "as 'tahoe run --stream$SAME' does)."
  else
    say "Stopped. Finished stages are kept: 'tahoe run$SAME' continues from there."
  fi
}

cmd_status() {
  need_packages
  local p
  if p="$(job_pid)"; then
    case "$(job_cmd "$p")" in
      *"hf download"*) say "Downloading into $DATA (pid $p). Last lines of its log:"
                       tail -n 4 "$OUT/download.log" 2>/dev/null | sed 's/^/  /' ;;
      *"tahoemap review"*) say "Literature review running (pid $p; 'tahoe review status$SAME' for counts and" \
                               "spend). Last lines of its log:"
                           tail -n 4 "$CONSOLE" 2>/dev/null | sed 's/^/  /' ;;
      *) say "Running (pid $p). Last lines of the log:"
         tail -n 4 "$OUT/run.log" 2>/dev/null | sed 's/^/  /' ;;
    esac
    say ""
  elif [ -f "$OUT/download.log" ]; then
    case "$(tail -n 1 "$OUT/download.log" 2>/dev/null)" in
      "DOWNLOAD FAILED"*|"DOWNLOAD STOPPED"*)
        say "The download into $DATA did not finish ($(tail -n 1 "$OUT/download.log"));" \
            "'tahoe download$SAME' resumes it."
        say "" ;;
    esac
  fi
  tm status "$@"
}

cmd_test() {
  need_packages
  local wd="${TAHOE_TEST_DIR:-${TMPDIR:-/tmp}/tahoemap_test}"
  say "Synthetic data and the whole pipeline in $wd (a few minutes) ..."
  (cd "$REPO" && "$PY" tests/run_tests.py --workdir "$wd" "$@") || return 1
  say ""
  say "The literature-review layer on that output (fake client: no API key, no network) ..."
  (cd "$REPO" && "$PY" tests/test_review.py --out "$wd/out_seed0") || return 1
  (cd "$REPO" && "$PY" tests/test_port.py) || return 1
}

ABS=()
not_a_key() {                    # a key given to --keys-file by mistake: refused, never echoed (it is no path)
  case "$1" in *sk-ant-*)
    die "--keys-file expects the path of a FILE with one key a line; the value given looks like an API key itself" \
        "(not shown). Put the key in a file (chmod 600) or in ANTHROPIC_API_KEY, and clear it from your shell" \
        "history." ;;
  esac
}
abs_paths() {                    # path options made absolute (tm runs in the repository folder): ABS=(...)
  ABS=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --keys-file|--fake|--repo)
        [ $# -ge 2 ] || die "$1 needs a path"
        [ "$1" = --keys-file ] && not_a_key "$2"
        ABS+=("$1" "$(absolute "$2")"); shift 2 ;;
      --keys-file=*|--fake=*|--repo=*)
        case "$1" in --keys-file=*) not_a_key "${1#*=}" ;; esac
        ABS+=("${1%%=*}=$(absolute "${1#*=}")"); shift ;;
      --only)
        [ $# -ge 2 ] || die "--only needs names (or @FILE)"
        case "$2" in @*) ABS+=("$1" "@$(absolute "${2#@}")") ;; *) ABS+=("$1" "$2") ;; esac
        shift 2 ;;
      --only=@*) ABS+=("--only=@$(absolute "${1#--only=@}")"); shift ;;
      *) ABS+=("$1"); shift ;;
    esac
  done
}

cmd_review() {                   # tahoe review [plan|run|status|tables] [--background] [options]
  need_packages
  local bg=0 action=status a p args=()
  for a in "$@"; do
    if [ "$a" = --background ]; then bg=1; else args+=("$a"); fi
  done
  case "${args[0]:-}" in plan|run|status|tables) action="${args[0]}" ;; -*|'') ;;
    *) die "review: unknown action '${args[0]}' (plan, run, status or tables; tahoe help)" ;; esac
  abs_paths ${args[@]+"${args[@]}"}
  if [ "$action" = run ]; then          # plan / status / tables (and the dossiers) need no SDK
    "$PY" -c "import anthropic" 2>/dev/null || die "the Anthropic SDK is missing: $PY -m pip install anthropic"
  fi
  if [ $bg = 1 ]; then
    [ "$action" = run ] || die "only 'tahoe review run' goes to the background (--background)"
    case " ${ABS[*]} " in
      *" --keys-file "*|*" --keys-file="*|*" --dry-run "*|*" --fake "*|*" --fake="*) ;;
      *) [ -n "${ANTHROPIC_API_KEYS:-}${ANTHROPIC_API_KEY:-}" ] ||
           die "a background review cannot ask for a new key when one runs out: give --keys-file FILE (one key a" \
               "line, readable only by you) or set ANTHROPIC_API_KEY / ANTHROPIC_API_KEYS, or run it in the" \
               "foreground (without --background)" ;;
    esac
    start_job review ${ABS[@]+"${ABS[@]}"}
    return
  fi
  if [ "$action" = run ]; then
    if p="$(job_pid)"; then
      die "a job is running on $OUT (pid $p): wait for it, or 'tahoe stop$SAME' first"
    fi
    say "(in the foreground: Ctrl-C pauses the review and the same command resumes it; when every key has run out" \
        "it asks for a new one; --background runs it as a job)"
  fi
  tm review ${ABS[@]+"${ABS[@]}"}
}

cmd_duplicate() {                # tahoe duplicate DEST [--repo DIR]: DEST and DIR as typed, from this folder
  need_packages
  local p dest="" args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo) [ $# -ge 2 ] || die "--repo needs a folder"; args+=("$1" "$(absolute "$2")"); shift 2 ;;
      --repo=*) args+=("--repo=$(absolute "${1#--repo=}")"); shift ;;
      -*) args+=("$1"); shift ;;
      *) [ -z "$dest" ] || die "duplicate: one destination folder (got '$dest' and '$1')"
         dest="$(absolute "$1")"; args+=("$dest"); shift ;;
    esac
  done
  [ -n "$dest" ] || die "usage: tahoe duplicate DEST [--repo DIR]   (copies $OUT; --out picks another run)"
  if p="$(job_pid)"; then die "a job is running on $OUT (pid $p): wait for it, or 'tahoe stop$SAME' first"; fi
  tm duplicate "${args[@]}"
}

cmd_update() {
  if job_pid >/dev/null; then die "a job is running; wait for it or 'tahoe stop$SAME' first"; fi
  git -C "$REPO" pull --ff-only || die "git pull failed"
  say "Updated. 'tahoe run' redoes the first stage whose method changed and every stage after it."
}

cmd_help() {
  cat <<EOF
tahoe - every gene, drug and cell line of Tahoe-100M in one map
  setup                 Python environment ($VENV) and this command on your PATH
  download              Tahoe-100M into $DATA (~340 GB; resumes)    [or skip it: run --stream]
  run [--stream]        every stage that is missing or out of date, in the background
  status                what is done and what runs next (also just: tahoe)
  log [download|review] follow the running job's log            stop    stop it (finished stages are kept)
  gene SYMBOL           drugs that raise / lower it, in which lines, genes that move with / opposite it
  drug NAME | line NAME | pair GENE1 GENE2 | module N        the same for a drug, a cell line, two genes
  open                  where the interactive map, the Obsidian vault and the validation report are
  review plan           AI literature-review agents (docs/review.md): the queue, in priority order, and its cost
  review run [options]  review genes / drugs / lines: needs --max-usd X or --limit N (or --no-cap); --kinds
                        gene,drug,line  --only NAMES|@FILE  --keys-file FILE  --dry-run (sends nothing)  --model
                        --effort  --verify llm|ids|off  --no-web  --concurrency N  --redo  --retry-failed
                        --recheck (only the verification stored reviews lack). In the foreground:
                        Ctrl-C pauses, the same command resumes, a new key is asked for when all have run out;
                        --background: as a job (stop, log; needs --keys-file or ANTHROPIC_API_KEY(S))
  review status|tables  counts, spend and projected cost of the rest / rebuild review/connections + findings
  duplicate DEST [--repo DIR]     copy this output for review work (big arrays hard-linked; --repo DIR: also
                        clone this code repository there); then: tahoe review ... --out DEST
  test                  the whole pipeline on synthetic data with planted answers (a few minutes)
  update                newest scripts (git pull)
  <stage> [options]     one stage now, in the foreground: build effects tensor tables embed reference
                        relations graph validate vault map
Folders: data $DATA   output $OUT
  (change them with --data DIR / --out DIR on every command, or set TAHOE_DATA / TAHOE_OUT)
Options go to python -m tahoemap (e.g. tahoe run --dims 96 --offline); see README.md.
  run --from reference  fetch the public annotations again (a source that failed is retried by any run online)
EOF
}

main() {
  local c="${1:-status}"
  [ $# -gt 0 ] && shift
  case "$c" in
    status|st) cmd_status "$@" ;;
    run) need_packages; start_job run "$@" ;;
    setup|install) cmd_setup ;;
    download) cmd_download ;;
    log|logs) cmd_log "$@" ;;
    stop) cmd_stop ;;
    test) cmd_test "$@" ;;
    update) cmd_update ;;
    help|-h|--help) cmd_help ;;
    gene|drug|line|pair|module) need_packages; tm "$c" "$@" ;;
    review) cmd_review "$@" ;;
    duplicate) cmd_duplicate "$@" ;;
    open|where)
      say "Interactive map:  $OUT/map/gene_map.html   (open it in a browser)"
      say "Obsidian vault:   $OUT/vault   (Obsidian: Open folder as vault)"
      say "Validation:       $OUT/validation/report.md" ;;
    build|effects|tensor|tables|embed|reference|relations|graph|validate|vault|map)
      need_packages; tm "$c" "$@" ;;
    *) die "unknown command '$c' (tahoe help)" ;;
  esac
}

main "$@"
